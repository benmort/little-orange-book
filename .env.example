# Set this to put a shared password in front of the whole site, and leave it
# unset (or delete it) to make the booklet public. See lib/site-gate.ts.
#
# Use the same value as the No Room for Racism site so one password covers both.
# This repository is PUBLIC — the real value belongs in .env.local (git-ignored)
# and in the Vercel project's environment variables, never in a committed file.
SITE_PASSWORD=

# For `npm run quotes` only — never needed at build or at runtime. A free key
# from https://www.openaustralia.org.au/api/key. Same rule: .env.local, not here.
OPENAUSTRALIA_API_KEY=
